---
import Icon from './Icon.astro';
import { site, url } from '../data/site';

interface Props {
  image: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
}
const { image, eyebrow, title, subtitle } = Astro.props;
---

<section class="hero" style={`--hero-img: url('${url(image)}')`}>
  <div class="container hero-inner">
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="hero-sub">{subtitle}</p>}
    <div class="btn-row">
      <a class="btn btn-lg" href={url('/contactus/#quote')}>Get a free quote</a>
      <a class="btn btn-lg btn-whatsapp" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp Ashley</a>
    </div>
  </div>
</section>
