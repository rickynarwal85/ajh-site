---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/ContactForm.astro';
import Reviews from '../components/Reviews.astro';
import SocialGateway from '../components/SocialGateway.astro';
import { site, url } from '../data/site';
import { sidebarServices } from '../data/services';
import { expertise } from '../data/expertise';

// Condensed from the original four-stage process copy.
const steps = [
  {
    title: 'Free quotation',
    text: 'We meet to talk through your project and any concerns, look at your drawings (or introduce our preferred architect), then give you a free, no-obligation quote and a clear payment schedule.',
  },
  {
    title: 'Preparation',
    text: 'Once we’ve agreed a start date we prepare and secure the site, with fencing where it’s needed, and keep noise and disruption to a minimum.',
  },
  {
    title: 'Construction',
    text: 'We supervise every delivery and arrange all the trades, keep the site tidy, and are courteous to you, your neighbours and visitors throughout.',
  },
  {
    title: 'Completion',
    text: 'We walk through the finished work with you to make sure you’re happy, and deal with anything outstanding promptly and professionally.',
  },
];
---

<Layout>
  <Hero
    image="/images/property-development.jpg"
    eyebrow="Hitchin · Hertfordshire · Since 2000"
    title="Hertfordshire builders who know the regs inside out"
    subtitle="Extensions, loft conversions, new builds and renovations. One point of contact from first quote to final handover."
  />
  <TrustBar />

  <Section id="services">
    <div class="section-head">
      <p class="eyebrow">What we do</p>
      <h2 class="dash-heading">Quality builds across Hertfordshire for over 20 years</h2>
      <p class="lead">
        Whether it’s an extension, a complete renovation or a new build, we bring the specialist knowledge, experience
        and care to help you create the perfect living space for you and your family.
      </p>
    </div>
    <div class="service-grid">
      {sidebarServices.map((s) => (
        <a class="service-card" href={url(`/${s.slug}/`)}>
          <img src={url(s.slideImage)} alt="" loading="lazy" />
          <span>{s.name}</span>
        </a>
      ))}
    </div>
  </Section>

  <Section variant="alt">
    <div class="section-head">
      <p class="eyebrow">Built right, first time</p>
      <h2 class="dash-heading">We know the “why”, not just the “how”</h2>
      <p class="lead">
        Every job is built to UK Building Regulations, and we explain what they mean for your project. You’ll know why
        each step is needed before you pay for it, and there are no nasty surprises at inspection.
      </p>
    </div>
    <div class="why-grid">
      {expertise.map((e) => (
        <div class="why-card">
          <h4>{e.title}</h4>
          <div class="reg">{e.reg}</div>
          <p>{e.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section>
    <div class="two-col">
      <div class="profile-photo" style="aspect-ratio:4/3">[Photo of Ashley on site]</div>
      <div>
        <p class="eyebrow">{site.owner.role}</p>
        <h2 class="dash-heading">Meet Ashley</h2>
        <p class="lead">
          {site.owner.name} quotes your job, builds it and runs it, so you deal with one person from first visit to final
          handover. No sales team, no being passed around.
        </p>
        <a class="btn btn-outline" href={url('/meet-ashley/')}>Meet Ashley</a>
      </div>
    </div>
  </Section>

  <Section variant="alt">
    <div class="section-head">
      <p class="eyebrow">How it works</p>
      <h2 class="dash-heading">From first visit to final handover</h2>
    </div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section>
    <Reviews />
  </Section>

  <Section variant="alt">
    <SocialGateway />
  </Section>
</Layout>
