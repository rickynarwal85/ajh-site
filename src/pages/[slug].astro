---
// One page per service, generated from src/data/services.ts
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { url } from '../data/site';
import { services, type Service } from '../data/services';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const description = service.sections.flatMap((s) => s.paragraphs ?? [])[0]?.slice(0, 155);
---

<Layout title={service.title} description={description}>
  <h1 class="page-title dash-heading">{service.title}</h1>
  <img class="hero-img" src={url(service.image)} alt={service.name} />

  {service.sections.map((section) => (
    <section>
      {section.heading && <h3>{section.heading}</h3>}
      {section.paragraphs?.map((p) => <p>{p}</p>)}
      {section.list && <ul>{section.list.map((li) => <li>{li}</li>)}</ul>}
    </section>
  ))}

  <ContactForm />
</Layout>
