---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, socials, mainNav, url } from '../data/site';
import { services, sidebarServices } from '../data/services';

interface Props {
  title?: string;
  description?: string;
  /** Hide the "Talk to Ashley" band above the footer (e.g. on the Contact page). */
  hideCta?: boolean;
}

const { title, description = site.about, hideCta = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Builders in Hitchin, Hertfordshire`;
const current = Astro.url.pathname;
const isActive = (href: string) => current === url(href);
const isServicePage = services.some((s) => isActive(`/${s.slug}/`));

// Set when building the side-by-side redesign preview (see .github/workflows/deploy.yml).
const preview = import.meta.env.PUBLIC_PREVIEW;
const currentVersionHref = current.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '/ajh-site');

// Tells Google who the business is, where it is and how to contact it (local search).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.name,
  url: Astro.site ? new URL(url('/'), Astro.site).href : undefined,
  logo: Astro.site ? new URL(url('/images/logo.jpg'), Astro.site).href : undefined,
  telephone: '+441462612168',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '4 Coppice Mead',
    addressLocality: 'Hitchin',
    addressRegion: 'Hertfordshire',
    postalCode: 'SG5 4JX',
    addressCountry: 'GB',
  },
  areaServed: 'Hertfordshire',
  founder: { '@type': 'Person', name: site.owner.name, jobTitle: site.owner.role },
  openingHours: 'Mo-Fr 08:00-17:00',
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141f55" />
    {preview && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    {preview && (
      <div class="preview-banner">
        Preview of the proposed redesign · <a href={currentVersionHref}>View current version →</a>
      </div>
    )}

    <div class="top-bar">
      <div class="container top-bar-inner">
        <div class="top-left">
          <span class="top-item"><Icon name="home" />Hitchin, Hertfordshire · Since 2000</span>
          <span class="top-item"><Icon name="clock" />{site.hours}</span>
        </div>
        <div class="top-right">
          <a class="top-item" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
          <a class="top-item" href={site.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" />{site.mobile}</a>
          <a class="top-item" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
          <span class="top-social">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.key} /></a>
            ))}
          </span>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container menu-inner">
        <a href={url('/')} class="logo" aria-label="AJH Building Contractors home"><Logo /></a>
        <nav id="main-nav" class="main-nav" aria-label="Main">
          <ul>
            {mainNav.map((item) =>
              item.services ? (
                <li class="has-sub">
                  <a href={url(item.href)} class:list={{ active: isServicePage }} aria-haspopup="true">{item.label}</a>
                  <ul class="sub-menu">
                    {sidebarServices.map((s) => (
                      <li><a href={url(`/${s.slug}/`)} class:list={{ active: isActive(`/${s.slug}/`) }}>{s.name}</a></li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li><a href={url(item.href)} class:list={{ active: isActive(item.href) }}>{item.label}</a></li>
              )
            )}
          </ul>
          <div class="nav-mobile-extra">
            <a href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
            <a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
            <div class="nav-social">
              {socials.map((s) => (
                <a class="social" href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.key} size={16} /></a>
              ))}
            </div>
          </div>
        </nav>
        <a href={url('/contactus/#quote')} class="btn header-cta">Free Quote</a>
        <button class="menu-toggle" aria-label="Menu" aria-expanded="false" aria-controls="main-nav"><span></span></button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {!hideCta && <CtaBand />}

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-about">
          <Logo class="logo-footer" />
          <p>{site.about}</p>
          <div class="footer-social">
            {socials.map((s) => (
              <a class="social" href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.key} size={16} /></a>
            ))}
          </div>
        </div>
        <div>
          <h4>Services</h4>
          <ul class="footer-links">
            {sidebarServices.map((s) => <li><a href={url(`/${s.slug}/`)}>{s.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul class="footer-links">
            {mainNav.filter((i) => !i.services).map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
            <li><a href={site.google} target="_blank" rel="noopener">Google reviews</a></li>
          </ul>
        </div>
        <div>
          <h4>Contact</h4>
          <p>{site.address}</p>
          <p>
            <a href={site.phoneHref}>{site.phone}</a><br />
            <a href={site.whatsappHref} target="_blank" rel="noopener">{site.mobile} (WhatsApp)</a><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          <p>{site.hours}</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} {site.name}. All Rights Reserved.</p>
        <a href={url('/privacy-policy/')}>Privacy Policy</a>
      </div>
    </footer>

    <!-- Phone-only action bar: the three things a visitor on a phone actually wants to do. -->
    <nav class="mobile-actions" aria-label="Quick contact">
      <a href={site.phoneHref}><Icon name="phone" size={20} /><span>Call</span></a>
      <a href={site.whatsappHref} target="_blank" rel="noopener" class="wa"><Icon name="whatsapp" size={20} /><span>WhatsApp</span></a>
      <a href={url('/contactus/#quote')} class="quote"><Icon name="quote" size={20} /><span>Free Quote</span></a>
    </nav>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.getElementById('main-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('nav-open', open);
      });
    </script>
  </body>
</html>
